# DraftStudio environment template
# Copy to .env and fill in real values. NEVER commit .env.

# --- Groq API (fast inference for open-weight models) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model selection (override without touching code/config)
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# --- Alternative providers (future use / fallbacks) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Notion: no key needed — connected via Notion MCP with OAuth
