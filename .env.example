# DraftStudio environment template
# Copy to .env and fill in real values. NEVER commit .env.

# --- Groq API (fast inference for open-weight models) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model selection (override without touching code/config)
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b


# --- OpenRouter (multi-provider gateway, OpenAI-compatible) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model selection: OpenRouter IDs look like provider/model (set the ones you want).
# NOTE: n8n does not read this file. The n8n workflow hard-codes its model IDs on the nodes
# (docs/n8n_workflow_design.md, section 4); these values are reference values for the Python
# harness and a record of what the workflow uses. Changing them does not change the workflow.
OPENROUTER_PRIMARY_MODEL=your-openrouter-primary-model-id
OPENROUTER_FALLBACK_MODEL=your-openrouter-fallback-model-id
# ReviewAgent judge in the n8n workflow (OpenRouter; its fallback is Groq llama-3.3-70b-versatile, set on the node)
OPENROUTER_REVIEW_MODEL=your-openrouter-review-model-id


# --- Alternative providers (future use / fallbacks) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here


# --- n8n (workflow automation; read by n8n-mcp via .mcp.json) ---
# Host-published port of the n8n container (container listens on 5678)
N8N_API_URL=http://localhost:5555
# Create in n8n: Settings -> n8n API
N8N_API_KEY=your-n8n-api-key-here


# --- Telegram (DraftStudio bot; create one with @BotFather) ---
# n8n keeps the token in its own credential store; these two are for reference and scripts only.
# TELEGRAM_ALLOWED_CHAT_ID enforces nothing by itself: put the same id in the Telegram Trigger's
# "Restrict to Chat IDs" field (the committed workflow holds a placeholder and rejects everyone
# until you do), otherwise anyone who finds the bot can spend your LLM quota.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_CHAT_ID=your-telegram-chat-id-here


# Notion: no key needed — connected via Notion MCP with OAuth

# Header Auth secret for the n8n Webhook node (credential "DraftStudio Webhook", header X-API-Key)
N8N_WEBHOOK_API_KEY=your-webhook-secret-here
