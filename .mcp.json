{
  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "n8n-mcp": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "set -a; [ -f ./.env ] && . ./.env; set +a; exec n8n-mcp"
      ],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_MCP_TELEMETRY_DISABLED": "true",
        "WEBHOOK_SECURITY_MODE": "moderate"
      }
    }
  }
}
