# DraftStudio .gitignore

# Local agent configuration (kept locally, not published)
/CLAUDE.md
CLAUDE.local.md
/PLAN.md
/.mcp.json
/skills-lock.json
.claude/
.agents/

# OS junk
.DS_Store
Thumbs.db

# Node (if any tooling is added later)
node_modules/
.env
.env.local

# Python (if any tooling is added later)
__pycache__/
*.pyc
.venv/

# Private working notes, reviews and run logs (kept locally, not published)
handoffs/*
!handoffs/.gitkeep
reviews/*
!reviews/.gitkeep
tests/live_runs/

# Local planning docs (kept locally, not published)
docs/superpowers/
