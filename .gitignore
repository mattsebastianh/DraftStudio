# DraftStudio .gitignore

# Secrets and environment
.env
.env.local

# Local agent configuration (kept locally, not published)
/CLAUDE.md
CLAUDE.local.md
/.mcp.json
/skills-lock.json
.claude/
.agents/

# Private working files (kept locally, not published); folders kept via .gitkeep
docs/*
!docs/.gitkeep
handoffs/*
!handoffs/.gitkeep
reviews/*
!reviews/.gitkeep
tests/live_runs/
# Pipeline output (generated by the harness); folder kept via .gitkeep
deliverables/*
!deliverables/.gitkeep

# Python / Node (if any tooling is added later)
__pycache__/
*.pyc
.venv/
node_modules/

# OS junk
.DS_Store
Thumbs.db
