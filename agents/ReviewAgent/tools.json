[
  {
    "name": "check_requirements",
    "description": "Verify the deliverable against every requirement in the original brief, producing pass/fail per requirement.",
    "parameters": {
      "type": "object",
      "properties": {
        "draft": {
          "type": "object",
          "description": "The draft deliverable to check",
          "properties": {
            "title": { "type": "string" },
            "content": { "type": "string" },
            "word_count": { "type": "integer" },
            "unsupported": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["content"]
        },
        "brief": {
          "type": "object",
          "description": "The original brief with requirements",
          "properties": {
            "topic": { "type": "string" },
            "audience": { "type": "string" },
            "tone": { "type": "string" },
            "length": { "type": "string" },
            "key_points": { "type": "array", "items": { "type": "string" } },
            "format": { "type": "string" }
          },
          "required": ["topic"]
        }
      },
      "required": ["draft", "brief"]
    }
  },
  {
    "name": "assess_quality",
    "description": "Score the deliverable on quality dimensions: clarity, accuracy, completeness, tone alignment. Returns a per-dimension score 0-100 for each dimension plus a composite score 0-100 consistent with them.",
    "parameters": {
      "type": "object",
      "properties": {
        "draft": {
          "type": "object",
          "description": "The draft deliverable to score",
          "properties": {
            "content": { "type": "string" },
            "unsupported": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["content"]
        },
        "requirements_result": {
          "type": "array",
          "description": "Results from check_requirements",
          "items": {
            "type": "object",
            "properties": {
              "requirement": { "type": "string" },
              "passed": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["draft"]
    }
  },
  {
    "name": "flag_issues",
    "description": "Identify and categorize specific problems with severity levels and suggested fixes.",
    "parameters": {
      "type": "object",
      "properties": {
        "requirements_result": {
          "type": "array",
          "description": "Per-requirement pass/fail results from check_requirements",
          "items": {
            "type": "object",
            "properties": {
              "requirement": { "type": "string" },
              "passed": { "type": "boolean" },
              "note": { "type": "string" }
            }
          }
        },
        "quality_score": {
          "type": "integer",
          "description": "Composite quality score from assess_quality"
        },
        "unsupported_claims": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of unsupported claims from the draft"
        }
      },
      "required": ["requirements_result", "quality_score"]
    }
  },
  {
    "name": "send_to_DraftAgent",
    "description": "Send a revision request back to DraftAgent with specific issues to address.",
    "parameters": {
      "type": "object",
      "properties": {
        "draft_title": {
          "type": "string",
          "description": "Title of the draft being sent back"
        },
        "issues": {
          "type": "array",
          "description": "Issues to address in the revision",
          "items": {
            "type": "object",
            "properties": {
              "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
              "category": { "type": "string" },
              "description": { "type": "string" },
              "suggested_fix": { "type": "string" }
            },
            "required": ["severity", "description", "suggested_fix"]
          }
        },
        "revision_round": {
          "type": "integer",
          "description": "Current revision cycle number"
        },
        "brief": {
          "type": "object",
          "description": "The original brief, so the revision keeps every requirement in view"
        },
        "previous_draft": {
          "type": "object",
          "description": "The draft being revised",
          "properties": {
            "title": { "type": "string" },
            "content": { "type": "string" },
            "format": { "type": "string" },
            "unsupported": { "type": "array", "items": { "type": "string" } },
            "word_count": { "type": "integer" }
          }
        }
      },
      "required": ["draft_title", "issues", "revision_round"],
      "additionalProperties": false
    }
  },
  {
    "name": "send_to_DispatchAgent",
    "description": "Send an approved deliverable to DispatchAgent for packaging and delivery.",
    "parameters": {
      "type": "object",
      "properties": {
        "draft": {
          "type": "object",
          "description": "The approved draft deliverable",
          "properties": {
            "title": { "type": "string" },
            "content": { "type": "string" },
            "format": { "type": "string" }
          },
          "required": ["title", "content"]
        },
        "review_summary": {
          "type": "object",
          "description": "Summary of the review result",
          "properties": {
            "score": { "type": "integer" },
            "dimension_scores": {
              "type": "object",
              "description": "Per-dimension quality scores (0-100)",
              "properties": {
                "clarity": { "type": "integer" },
                "accuracy": { "type": "integer" },
                "completeness": { "type": "integer" },
                "tone_alignment": { "type": "integer" }
              }
            },
            "revision_rounds": { "type": "integer" },
            "review_status": { "type": "string", "enum": ["approved"] }
          }
        },
        "sources": {
          "type": "array",
          "description": "Research sources used by the draft",
          "items": {
            "type": "object",
            "properties": { "title": { "type": "string" }, "url": { "type": "string" } },
            "required": ["url"]
          }
        },
        "client_preferences": {
          "type": "object",
          "description": "Client formatting and delivery preferences passed through from IntakeAgent context",
          "properties": {
            "format": { "type": "string" },
            "include_sources": { "type": "boolean" },
            "include_revision_history": { "type": "boolean" }
          }
        },
        "client_id": {
          "type": "string",
          "description": "Client identifier for tracking and delivery"
        }
      },
      "required": ["draft"],
      "additionalProperties": false
    }
  },
  {
    "name": "send_to_ResearchAgent",
    "description": "Request a targeted fact-check from ResearchAgent when factual accuracy cannot be verified.",
    "parameters": {
      "type": "object",
      "properties": {
        "claims_to_verify": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Specific claims that need fact-checking"
        },
        "context": {
          "type": "string",
          "description": "Context about why these claims need verification"
        },
        "draft_title": {
          "type": "string",
          "description": "Title of the draft being fact-checked, for correlation"
        },
        "revision_round": {
          "type": "integer",
          "description": "Current revision cycle number, for correlation"
        }
      },
      "required": ["claims_to_verify", "draft_title", "revision_round"]
    }
  },
  {
    "name": "receive_from_DraftAgent",
    "description": "Receive a completed draft from DraftAgent for quality gate evaluation.",
    "parameters": {
      "type": "object",
      "properties": {
        "draft": {
          "type": "object",
          "description": "The completed draft deliverable",
          "properties": {
            "title": { "type": "string" },
            "content": { "type": "string" },
            "format": { "type": "string" },
            "unsupported": { "type": "array", "items": { "type": "string" } },
            "word_count": { "type": "integer" }
          },
          "required": ["title", "content"]
        },
        "brief": {
          "type": "object",
          "description": "Original brief for requirement comparison",
          "properties": {
            "topic": { "type": "string" },
            "audience": { "type": "string" },
            "tone": { "type": "string" },
            "length": { "type": "string" },
            "key_points": { "type": "array", "items": { "type": "string" } },
            "format": { "type": "string" }
          },
          "required": ["topic"]
        },
        "revision_round": {
          "type": "integer",
          "description": "Current revision cycle (0 = first submission)"
        },
        "deterministic_checks": {
          "type": "array",
          "description": "Rule-based check results computed by the harness before review",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "passed": { "type": "boolean" },
              "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
              "detail": { "type": "string" },
              "suggested_fix": { "type": "string" }
            },
            "required": ["id", "passed", "severity"]
          }
        }
      },
      "required": ["draft", "brief", "revision_round"],
      "additionalProperties": false
    }
  }
]